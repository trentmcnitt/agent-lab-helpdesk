# Public demo settings. Copy to .env.demo (gitignored) and adjust.
DEMO_MODE=replay                 # replay (no model calls) or live
ANTHROPIC_API_KEY=               # live only; use a key with its own low spend limit
DEMO_DAILY_USD=2.00              # hard daily cap across all visitors; then replays until UTC midnight
DEMO_RATE_PER_MINUTE=3           # live runs per client IP per minute
DEMO_RATE_PER_DAY=20             # live runs per client IP per UTC day
DEMO_MAX_CONCURRENT=4            # live runs in flight at once
DEMO_FREE_TEXT=0                 # 1 lets visitors type their own request (live only, 500 chars max)
DEMO_TRUST_PROXY=1               # read the client IP from X-Forwarded-For (behind Fly/Render/Caddy)
DEMO_SECURE_COOKIE=1             # 1 behind TLS
