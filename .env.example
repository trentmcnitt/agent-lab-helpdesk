# Copy to .env and fill in (or inject at launch time -- see SETUP.md).
# Never commit real values.

ANTHROPIC_API_KEY=

# Langfuse Cloud free tier (or a self-hosted instance's URL). Tracing is a
# sink, not a dependency -- the app runs fine with these unset; it just falls
# back to the JSONL run log in runs/.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional overrides -- see app/config.py for defaults.
# MODEL_ID=claude-sonnet-5
# CONFIDENCE_THRESHOLD=0.6
# RETRIEVAL_TOP_K=4

# Real Slack over Socket Mode (optional; both or neither). See SETUP.md.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_CHANNEL=helpdesk-requests

# mcp (default): the board is reached over MCP via mcp_board/server.py; local: direct SQLite
# BOARD_BACKEND=mcp

# Agent Lab (optional): runs go to the bench at http://127.0.0.1:8790 when one is running there.
# Set only when it runs on another machine; "off" disables it.
# AGENT_LAB_URL=http://127.0.0.1:8790

# Less common
# LANGFUSE_HOST=            # alias for LANGFUSE_BASE_URL (either works)
# BOARD_DB_PATH=data/board.db   # only when running `python -m mcp_board.server` on its own
# INVARIANT_K=3             # real runs per adversarial trap in the live invariant tests
